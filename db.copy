<?php
/**
 * WP PostgreSQL Database Drop-in
 *
 * This file is installed to wp-content/db.php during plugin activation.
 * It intercepts WordPress database calls at bootstrap time, before any
 * plugin or theme loads, and replaces the global $wpdb instance with
 * the PostgreSQL-aware WP_db_PgSQL subclass.
 *
 * DO NOT EDIT THIS FILE DIRECTLY.
 * It is managed by the WP PostgreSQL Database plugin.
 *
 * @link              https://github.com/mralaminahamed/wp-pgsql-database
 * @since             1.0.0
 * @package           WP_PgSQL_Database
 *
 * @wordpress-plugin
 * Plugin Name:       WP PostgreSQL Database (db.php)
 * Plugin URI:        https://github.com/mralaminahamed/wp-pgsql-database
 * Description:       PostgreSQL database drop-in for WordPress. Managed by the WP PostgreSQL Database plugin.
 * Version:           1.0.0
 * Author:            Al Amin Ahamed
 * Author URI:        https://alaminahamed.com
 * License:           GPL-2.0+
 * License URI:       http://www.gnu.org/licenses/gpl-2.0.txt
 * Text Domain:       wp-pgsql-database
 * Domain Path:       /languages
 * Requires at least: 6.0
 * Tested up to:      6.9
 * Requires PHP:      7.4
 */

declare( strict_types=1 );

// Ensure WordPress is loading this file.
if ( ! defined( 'ABSPATH' ) ) {
	exit;
}

// Only activate when the DB_ENGINE constant designates pgsql.
if ( ! defined( 'DB_ENGINE' ) || 'pgsql' !== DB_ENGINE ) {
	return;
}

// Locate the plugin in either plugins or mu-plugins directory.
$_wp_pgsql_plugin_path = '';

foreach ( [ WPMU_PLUGIN_DIR, WP_PLUGIN_DIR ] as $_wp_pgsql_dir ) {
	$_wp_pgsql_candidate = trailingslashit( $_wp_pgsql_dir ) . 'wp-pgsql-database/wp-pgsql-database.php';
	if ( file_exists( $_wp_pgsql_candidate ) ) {
		$_wp_pgsql_plugin_path = dirname( $_wp_pgsql_candidate );
		break;
	}
}

if ( '' === $_wp_pgsql_plugin_path ) {
	// Plugin directory not found; fall back to default wpdb to prevent fatal errors.
	return;
}

unset( $_wp_pgsql_dir, $_wp_pgsql_candidate );

// Require only the files necessary at drop-in bootstrap time.
require_once $_wp_pgsql_plugin_path . '/includes/driver/class-wp-pgsql-driver-interface.php';
require_once $_wp_pgsql_plugin_path . '/includes/driver/class-wp-pgsql-driver.php';
require_once $_wp_pgsql_plugin_path . '/includes/translator/class-wp-pgsql-lexer.php';
require_once $_wp_pgsql_plugin_path . '/includes/translator/class-wp-pgsql-token.php';
require_once $_wp_pgsql_plugin_path . '/includes/translator/class-wp-pgsql-translator.php';
require_once $_wp_pgsql_plugin_path . '/includes/database/class-wp-pgsql-db.php';

unset( $_wp_pgsql_plugin_path );

/**
 * Instantiate the PostgreSQL-aware wpdb subclass and register it globally.
 *
 * WordPress checks for a $wpdb global at several early bootstrap points.
 * We create the instance here so it is available when wp-settings.php runs.
 */
$wpdb = new \WP_PgSQL_Database\Database\WP_PgSQL_Db(
	DB_USER,
	DB_PASSWORD,
	DB_NAME,
	DB_HOST
);

// Register as a global for legacy access.
$GLOBALS['wpdb'] = $wpdb;
